prefix=C:/condaenvs/hazus_env/Library
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: hdf5
Description: HDF5 (Hierarchical Data Format 5) Software Library
Version: 1.10.6

Cflags: -I${includedir}
Libs: -L${libdir}  -lhdf5
Requires: 
Libs.private:  -lC:/condaenvs/hazus_env/Library/lib/libcurl.lib -lC:/condaenvs/hazus_env/Library/lib/libssl.lib -lC:/condaenvs/hazus_env/Library/lib/libcrypto.lib -lC:/condaenvs/hazus_env/Library/lib/z.lib  -lhdf5
Requires.private: 
